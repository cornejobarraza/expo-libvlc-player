# Exclude all top-level hidden directories by convention
/.*/

# Exclude tarballs generated by npm pack
/*.tgz

# Module
/scripts/
/android/build/
/example/

# Tests
__tests__/
coverage/**/*

# Other
/.editorconfig
/.prettierrc
/.swift-version
/.swiftformat
/eslint.config.js
/lint-staged.config.js
/package-lock.json
/tsconfig.*.json
*.tsbuildinfo
